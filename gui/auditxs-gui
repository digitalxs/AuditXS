#!/usr/bin/env bash
#
# AuditXS — gui/auditxs-gui
# Graphical front-end (zenity + pkexec). Runs as your normal user; only the
# individual audit/harden/rollback operations are elevated through pkexec,
# so you see an authentication prompt exactly when privileges are used.
#
# The GUI is a thin wrapper over the CLI: everything it does can be done
# (and audited) with the same 'auditxs' commands it runs for you.
#

AUDITXS_BIN=${AUDITXS_BIN:-auditxs}

die_gui() {
    if command -v zenity >/dev/null 2>&1; then
        zenity --error --title "AuditXS" --text "$1" 2>/dev/null
    else
        echo "auditxs-gui: $1" >&2
    fi
    exit 1
}

command -v zenity >/dev/null 2>&1 \
    || die_gui "zenity is required for the AuditXS GUI.\nInstall it (e.g. 'sudo apt install zenity') or use the CLI: sudo auditxs"
command -v "$AUDITXS_BIN" >/dev/null 2>&1 \
    || die_gui "The 'auditxs' command was not found. Run the AuditXS installer first."

# Graphical interfaces are workstation-only. On the server profile, steer the
# user to the terminal UI (which works over SSH) instead.
if [ "$("$AUDITXS_BIN" profile 2>/dev/null)" = server ]; then
    die_gui "The graphical interface is disabled on the 'server' profile.\nUse the terminal UI over SSH:  sudo auditxs tui\nor the CLI:  sudo auditxs audit"
fi

# The zenity dialogs are drawn by the window manager and cannot carry their own
# minimize/maximize buttons. The Qt app IS a single application window with
# real window controls (minimize / maximize / restore / move / resize), so when
# it is available we prefer it. Force the choice with:
#   AUDITXS_GUI=qt      use the Qt window (error if PySide6 is missing)
#   AUDITXS_GUI=zenity  use the classic zenity dialogs
AUDITXS_QT_PY="$(dirname "$(readlink -f "$0")")/auditxs-qt.py"
qt_gui_available() {
    [ -f "$AUDITXS_QT_PY" ] && command -v python3 >/dev/null 2>&1 \
        && python3 -c 'import PySide6' >/dev/null 2>&1
}
case "${AUDITXS_GUI:-auto}" in
    zenity) : ;;                                   # keep the classic dialogs
    qt)
        qt_gui_available \
            || die_gui "AUDITXS_GUI=qt but the Qt window app is unavailable.\nInstall the 'auditxs-gui-qt' package (PySide6), or unset AUDITXS_GUI for the zenity interface."
        exec "$AUDITXS_BIN" qt ;;
    *)  qt_gui_available && exec "$AUDITXS_BIN" qt ;;   # auto: prefer the window app
esac

# Privilege elevation: pkexec (GUI prompt) with sudo fallback for terminals.
elevate() {
    if [ "$(id -u)" -eq 0 ]; then
        "$@"
    elif command -v pkexec >/dev/null 2>&1; then
        pkexec "$@"
    elif command -v sudo >/dev/null 2>&1 && [ -t 0 ]; then
        sudo "$@"
    else
        return 127
    fi
}

WORK_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/auditxs"
mkdir -p "$WORK_DIR"

# progress_feed <pid> <progress-file> — translate the engine's progress file
# ("PCT DONE TOTAL ID", see --progress-file) into zenity --progress input:
# a percentage line plus a "# label" line, until the background job exits.
progress_feed() {
    local pid=$1 prog=$2 pct d t cid
    while kill -0 "$pid" 2>/dev/null; do
        if IFS=' ' read -r pct d t cid < "$prog" 2>/dev/null && [ -n "${pct:-}" ]; then
            printf '%s\n' "$pct"
            printf '# %s  (%s/%s · %s%%)\n' "${cid:-working…}" "${d:-0}" "${t:-?}" "$pct"
        fi
        sleep 0.3
    done
    echo 100
}

run_audit_gui() {
    local out="$WORK_DIR/audit.tsv" rc_file="$WORK_DIR/audit.rc" prog="$WORK_DIR/audit.progress"
    rm -f "$out" "$rc_file"; : > "$prog"
    (
        elevate "$AUDITXS_BIN" audit --format tsv --quiet --progress-file "$prog" > "$out" 2>/dev/null
        echo $? > "$rc_file"
    ) &
    local apid=$!
    progress_feed "$apid" "$prog" | zenity --progress --title "AuditXS" \
        --text "Auditing system (read-only — nothing is changed)…" \
        --percentage=0 --no-cancel --auto-close 2>/dev/null
    wait "$apid" 2>/dev/null

    if [ "$(cat "$rc_file" 2>/dev/null)" != "0" ] || [ ! -s "$out" ]; then
        die_gui "The audit could not be run.\nAuthentication may have been cancelled."
    fi

    local rows=()
    local status id sev cat fixable title detail
    while IFS=$'\t' read -r status id sev cat fixable title detail; do
        rows+=("$status" "$id" "$sev" "$cat" "$title" "$detail")
    done < "$out"

    # Actionable results: pick a row → Fix / Details. FAIL rows with an
    # automatic fix get the consent + apply flow; everything else gets the
    # detailed manual-fix guidance. Close returns to the menu.
    local sel
    while sel=$(zenity --list --title "AuditXS — audit results" \
        --text "Select a row and press <b>Fix / Details</b> — failing checks with an automatic fix can be applied (reversible); others show detailed manual guidance." \
        --column "Status" --column "ID" --column "Severity" --column "Category" --column "Check" --column "Detail" \
        --print-column 2 --ok-label "Fix / Details" --cancel-label "Close" \
        --width 1000 --height 620 "${rows[@]}" 2>/dev/null); do
        [ -n "$sel" ] || break
        check_action_gui "$sel"
    done
    return 0
}

run_harden_gui() {
    local out="$WORK_DIR/audit.tsv"
    if [ ! -s "$out" ]; then
        zenity --info --title "AuditXS" --text "Run an audit first so AuditXS knows what needs fixing." 2>/dev/null
        return
    fi

    local rows=()
    local status id sev cat fixable title detail
    while IFS=$'\t' read -r status id sev cat fixable title detail; do
        [ "$status" = "FAIL" ] && [ "$fixable" = "yes" ] || continue
        rows+=(FALSE "$id" "$sev" "$title")
    done < "$out"

    if [ ${#rows[@]} -eq 0 ]; then
        zenity --info --title "AuditXS" \
            --text "No automatically fixable findings in the last audit.\nWARN items need manual review — see the report." 2>/dev/null
        return
    fi

    local chosen
    chosen=$(zenity --list --checklist --title "AuditXS — select fixes" \
        --text "Select the fixes to apply. Next you will see <b>exactly what each fix changes</b> before anything happens.\nEvery change is recorded in a snapshot and reversible via Rollback." \
        --column "Apply" --column "ID" --column "Severity" --column "Fix" \
        --width 900 --height 520 --separator " " "${rows[@]}" 2>/dev/null) || return
    [ -n "$chosen" ] || return

    # Full transparency: show what each selected fix changes, before consent.
    # shellcheck disable=SC2086
    "$AUDITXS_BIN" explain $chosen 2>/dev/null | sed 's/\x1b\[[0-9;]*m//g' > "$WORK_DIR/explain.txt"
    zenity --text-info --title "AuditXS — what will change" \
        --filename "$WORK_DIR/explain.txt" \
        --checkbox "I reviewed these changes and want to apply them." \
        --width 860 --height 600 2>/dev/null || return

    local cmd=("$AUDITXS_BIN" harden --yes --quiet)
    local c
    for c in $chosen; do cmd+=(--check "$c"); done

    local log="$WORK_DIR/harden.log" prog="$WORK_DIR/harden.progress"
    : > "$prog"
    (
        elevate "${cmd[@]}" --progress-file "$prog" > "$log" 2>&1
        echo $? > "$WORK_DIR/harden.rc"
    ) &
    local hpid=$!
    progress_feed "$hpid" "$prog" | zenity --progress --title "AuditXS" \
        --text "Applying selected fixes…" \
        --percentage=0 --no-cancel --auto-close 2>/dev/null
    wait "$hpid" 2>/dev/null

    sed 's/\x1b\[[0-9;]*m//g' "$log" > "$log.clean" 2>/dev/null && mv "$log.clean" "$log"
    zenity --text-info --title "AuditXS — hardening result (every change is listed)" \
        --filename "$log" --width 860 --height 600 2>/dev/null
    zenity --question --title "AuditXS" \
        --text "Re-run the audit now to verify the new state?" 2>/dev/null && run_audit_gui
}

# Features on/off — the toggle view the user drives to enable security
# controls. Checked = the control is ON (currently passing). Ticking an OFF
# control and applying turns it ON (harden). Turning a control OFF is done via
# Rollback (per-run, fully reversible) — noted in the dialog.
run_features_gui() {
    local out="$WORK_DIR/audit.tsv"
    if [ ! -s "$out" ]; then
        zenity --info --title "AuditXS" --text "Run an <b>Audit</b> first so AuditXS knows the current state of each feature." 2>/dev/null
        return
    fi
    local rows=() status id sev cat fixable title detail state
    while IFS=$'\t' read -r status id sev cat fixable title detail; do
        [ "$fixable" = yes ] || continue
        case $status in
            PASS) state=TRUE ;;   # feature is ON
            *)    state=FALSE ;;  # OFF / not applied
        esac
        rows+=("$state" "$id" "$([ "$state" = TRUE ] && echo 'ON ✓' || echo 'off')" "$cat" "$title")
    done < "$out"
    if [ ${#rows[@]} -eq 0 ]; then
        zenity --info --title "AuditXS" --text "No toggleable security features in the last audit." 2>/dev/null
        return
    fi

    local chosen
    chosen=$(zenity --list --checklist --title "AuditXS — Security features (on/off)" \
        --text "Each row is a security control. <b>Ticked = ON</b>. Tick an <b>off</b> control and press OK to turn it on — you will review exactly what changes first, and it is fully reversible.\nTo turn a control <b>off</b> again, use <b>Rollback</b>." \
        --column "On" --column "ID" --column "State" --column "Category" --column "Feature" \
        --width 940 --height 560 --separator " " "${rows[@]}" 2>/dev/null) || return
    [ -n "$chosen" ] || return

    # Enable only those that are ticked AND currently OFF (FAIL).
    local to_enable="" c cur
    for c in $chosen; do
        cur=$(awk -F'\t' -v id="$c" '$2==id{print $1}' "$out")
        [ "$cur" = PASS ] || to_enable+=" $c"
    done
    to_enable=${to_enable# }
    if [ -z "$to_enable" ]; then
        zenity --info --title "AuditXS" --text "Every ticked feature is already ON. Nothing to change.\n(To turn features off, use Rollback.)" 2>/dev/null
        return
    fi

    # shellcheck disable=SC2086
    "$AUDITXS_BIN" explain $to_enable 2>/dev/null | sed 's/\x1b\[[0-9;]*m//g' > "$WORK_DIR/explain.txt"
    zenity --text-info --title "AuditXS — what turning these on will change" \
        --filename "$WORK_DIR/explain.txt" \
        --checkbox "I reviewed these changes and want to turn these features ON." \
        --width 860 --height 600 2>/dev/null || return

    local cmd=("$AUDITXS_BIN" harden --yes --quiet) log="$WORK_DIR/harden.log" prog="$WORK_DIR/harden.progress"
    for c in $to_enable; do cmd+=(--check "$c"); done
    : > "$prog"
    ( elevate "${cmd[@]}" --progress-file "$prog" > "$log" 2>&1; echo $? > "$WORK_DIR/harden.rc" ) &
    local fpid=$!
    progress_feed "$fpid" "$prog" | zenity --progress --title "AuditXS" \
        --text "Turning on selected features…" --percentage=0 --no-cancel --auto-close 2>/dev/null
    wait "$fpid" 2>/dev/null
    sed 's/\x1b\[[0-9;]*m//g' "$log" > "$log.clean" 2>/dev/null && mv "$log.clean" "$log"
    zenity --text-info --title "AuditXS — result (every change is listed & reversible)" \
        --filename "$log" --width 860 --height 600 2>/dev/null
    zenity --question --title "AuditXS" --text "Re-run the audit to refresh feature states?" 2>/dev/null && run_audit_gui
}

# Security tooling submenu (status / install / scanners / VPN).
run_tools_gui() {
    local action
    action=$(zenity --list --title "AuditXS — Security tools" \
        --text "Install and run established security tooling. Installs are recorded and reversible via Rollback." \
        --column "Action" --column "Description" \
        "Status"   "Which security tools are installed" \
        "Install"  "Install a security tool (Lynis, CrowdSec, Suricata, AIDE, …)" \
        "Scan"     "Run installed scanners (Lynis, rkhunter, …) and collect reports" \
        "VPN"      "Review WireGuard / OpenVPN configuration" \
        --width 640 --height 400 2>/dev/null) || return
    case $action in
        Status)
            elevate "$AUDITXS_BIN" tools status 2>&1 | sed 's/\x1b\[[0-9;]*m//g' > "$WORK_DIR/tools.txt"
            zenity --text-info --title "AuditXS — security tooling" --filename "$WORK_DIR/tools.txt" --width 700 --height 480 2>/dev/null ;;
        Install)
            local tool
            tool=$(zenity --list --radiolist --title "AuditXS — install security tool" \
                --text "Choose a tool to install. AuditXS never pipes remote scripts to your shell — for CrowdSec/OSSEC it shows the official steps instead." \
                --column "" --column "Tool" --column "Purpose" \
                FALSE lynis "Host security auditor" \
                FALSE rkhunter "Rootkit detector" \
                FALSE chkrootkit "Rootkit detector (second opinion)" \
                FALSE clamav "Antivirus / malware scanner" \
                FALSE aide "File integrity monitoring" \
                FALSE openscap "SCAP compliance scanner (CIS/STIG)" \
                FALSE auditd "Linux kernel audit daemon" \
                FALSE debsecan "Precise Debian CVE tracking" \
                FALSE fail2ban "Log-based ban engine" \
                FALSE crowdsec "Collaborative intrusion prevention" \
                FALSE suricata "Network IDS/IPS" \
                FALSE usbguard "USB device allow-listing" \
                FALSE firejail "Application sandboxing" \
                --width 680 --height 540 2>/dev/null) || return
            [ -n "$tool" ] || return
            ( elevate "$AUDITXS_BIN" tools install "$tool" > "$WORK_DIR/toolinstall.log" 2>&1; echo $? >"$WORK_DIR/ti.rc" ) | \
                zenity --progress --title "AuditXS" --text "Installing $tool…" --pulsate --no-cancel --auto-close 2>/dev/null
            sed 's/\x1b\[[0-9;]*m//g' "$WORK_DIR/toolinstall.log" > "$WORK_DIR/toolinstall.clean" 2>/dev/null && mv "$WORK_DIR/toolinstall.clean" "$WORK_DIR/toolinstall.log"
            zenity --text-info --title "AuditXS — install $tool" --filename "$WORK_DIR/toolinstall.log" --width 760 --height 480 2>/dev/null ;;
        Scan)
            zenity --question --title "AuditXS" --text "Run all installed external scanners now?\n(This can take several minutes.)" 2>/dev/null || return
            ( elevate "$AUDITXS_BIN" tools scan > "$WORK_DIR/scan.log" 2>&1; echo $? >"$WORK_DIR/scan.rc" ) | \
                zenity --progress --title "AuditXS" --text "Running scanners…" --pulsate --no-cancel --auto-close 2>/dev/null
            sed 's/\x1b\[[0-9;]*m//g' "$WORK_DIR/scan.log" > "$WORK_DIR/scan.clean" 2>/dev/null && mv "$WORK_DIR/scan.clean" "$WORK_DIR/scan.log"
            zenity --text-info --title "AuditXS — scanner results" --filename "$WORK_DIR/scan.log" --width 820 --height 560 2>/dev/null ;;
        VPN)
            elevate "$AUDITXS_BIN" tools vpn 2>&1 | sed 's/\x1b\[[0-9;]*m//g' > "$WORK_DIR/vpn.txt"
            zenity --text-info --title "AuditXS — VPN review" --filename "$WORK_DIR/vpn.txt" --width 760 --height 460 2>/dev/null ;;
    esac
}

# CVE warning banner — shown after an audit when vulnerable packages exist.
cve_warn_gui() {
    local out="$WORK_DIR/cve.txt"
    elevate "$AUDITXS_BIN" cve > "$out" 2>/dev/null
    local rc=$?
    if [ "$rc" != 0 ] && grep -q 'reported vulnerability' "$out" 2>/dev/null; then
        sed 's/\x1b\[[0-9;]*m//g' "$out" > "$out.c" 2>/dev/null && mv "$out.c" "$out"
        zenity --warning --title "AuditXS — vulnerability warning" \
            --text "$(head -c 1200 "$out")" --width 640 2>/dev/null
    fi
}

run_report_gui() {
    local f="$WORK_DIR/report.html"
    (
        elevate "$AUDITXS_BIN" report --format html --quiet > "$f" 2>/dev/null
        echo $? > "$WORK_DIR/report.rc"
    ) | zenity --progress --title "AuditXS" --text "Generating HTML report (read-only audit)…" \
        --pulsate --no-cancel --auto-close 2>/dev/null
    if [ "$(cat "$WORK_DIR/report.rc" 2>/dev/null)" != "0" ] || [ ! -s "$f" ]; then
        die_gui "Report generation failed."
    fi
    xdg-open "$f" >/dev/null 2>&1 &
    zenity --info --title "AuditXS" --text "Report opened in your browser:\n$f" 2>/dev/null
}

run_rollback_gui() {
    local out="$WORK_DIR/snapshots.tsv"
    elevate "$AUDITXS_BIN" snapshots --tsv > "$out" 2>/dev/null
    if [ ! -s "$out" ]; then
        zenity --info --title "AuditXS" \
            --text "No snapshots found.\nSnapshots are created automatically when 'Harden' changes something." 2>/dev/null
        return
    fi
    local rows=()
    local id date profile n status
    while IFS=$'\t' read -r id date profile n status; do
        rows+=(FALSE "$id" "$date" "$profile" "$n" "$status")
    done < "$out"
    local chosen
    chosen=$(zenity --list --radiolist --title "AuditXS — rollback" \
        --text "Choose a snapshot to revert. Every recorded change is undone in reverse order." \
        --column "" --column "Snapshot" --column "Date" --column "Profile" --column "Actions" --column "State" \
        --width 820 --height 440 "${rows[@]}" 2>/dev/null) || return
    [ -n "$chosen" ] || return

    zenity --question --title "AuditXS" \
        --text "Revert every change recorded in snapshot <b>$chosen</b>?" 2>/dev/null || return

    local log="$WORK_DIR/rollback.log"
    (
        elevate "$AUDITXS_BIN" rollback "$chosen" --yes > "$log" 2>&1
        echo $? > "$WORK_DIR/rollback.rc"
    ) | zenity --progress --title "AuditXS" --text "Rolling back snapshot $chosen…" \
        --pulsate --no-cancel --auto-close 2>/dev/null
    sed 's/\x1b\[[0-9;]*m//g' "$log" > "$log.clean" 2>/dev/null && mv "$log.clean" "$log"
    zenity --text-info --title "AuditXS — rollback result" --filename "$log" --width 820 --height 560 2>/dev/null
}

