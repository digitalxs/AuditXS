#!/usr/bin/env bash
#
# AuditXS — transparent, reversible Linux security auditing & hardening.
# https://github.com/digitalxs/AuditXS
#
# Design principles:
#   1. TRANSPARENT — every check explains what it inspects, why it matters,
#      exactly what its fix changes, and how that change is reverted.
#      'auditxs audit' is strictly read-only.
#   2. REVERSIBLE — before anything is modified it is recorded in a snapshot
#      (file copies + action manifest). 'auditxs rollback' restores it.
#   3. CONSENTED — fixes are applied one by one, each after an explicit
#      confirmation (or --yes for automation), with --dry-run to preview.
#
# Copyright (c) 2026 DigitalXS <luis@digitalxs.ca>
#

AUDITXS_SELF=$(readlink -f "${BASH_SOURCE[0]}")
AUDITXS_ROOT=$(dirname "$AUDITXS_SELF")

for _lib in core errors distro backup registry waivers report fixlib maintenance cve tools fleet alerts; do
    # shellcheck disable=SC1090
    . "$AUDITXS_ROOT/lib/$_lib.sh" || { echo "auditxs: missing library lib/$_lib.sh" >&2; exit 1; }
done
for _chk in "$AUDITXS_ROOT"/checks/*.sh; do
    # shellcheck disable=SC1090
    . "$_chk" || { echo "auditxs: failed to load $_chk" >&2; exit 1; }
done

AUDITXS_CONF=/etc/auditxs/auditxs.conf

usage() {
    cat <<EOF
${BOLD}AuditXS v$AUDITXS_VERSION${RC} — transparent, reversible Linux security auditing

${BOLD}USAGE${RC}
  auditxs <command> [options]

${BOLD}COMMANDS${RC}
  audit       Run all applicable checks (read-only — never changes anything)
  harden      Review failed checks and apply fixes one by one, with consent
  rollback    Revert a hardening snapshot:  auditxs rollback <id> | latest
  snapshots   List change snapshots
  list        Show the check catalogue (add --markdown for full docs)
  explain     Show full documentation for checks:  auditxs explain SSH-001 ...
  report      Print a report of a fresh audit to stdout (--format html|json|tsv)
  diff        Compare two saved JSON reports:  auditxs diff <baseline.json> [current.json]
              (current defaults to the latest saved report; exits 1 on regressions)
  baseline    Manage the approved baseline:  auditxs baseline set [report] | show | clear
  schedule    Daily audit + drift alert:  auditxs schedule enable | disable | status | run
  doctor      Diagnose the AuditXS installation, tooling and snapshot integrity
  cve         Warn about installed packages with a known vulnerability / CVE
  tools       Security tooling:  auditxs tools status | install <name> | scan | vpn
  fleet       Audit many hosts over SSH (read-only):  auditxs fleet <host...> [options]
  waive       Accept a finding as a documented risk:  auditxs waive <ID> "reason" [--until DATE]
  waivers     List accepted-risk waivers   ·   unwaive <ID> removes one
  alert       Configure/test drift & CVE alert sinks:  auditxs alert status | test
  errors      Browse the error-code catalogue:  auditxs errors [CODE|term|log]
  tui         Launch the terminal (ncurses) interface — works over SSH; server-friendly
  web         Launch the local web UI (Material Design 3) — workstation profile only
  qt          Launch the native Qt/QML desktop app — workstation profile only
  electron    Launch the Electron desktop app (web UI in a window) — workstation only
  profile     Print the resolved profile (server|workstation)
  version     Show version
  help        Show this help

${BOLD}INTERFACES BY PROFILE${RC}
  server        CLI + terminal UI (tui) only — no web/graphical server on this box
  workstation   all of the above plus web UI, Qt app and the zenity GUI

${BOLD}OPTIONS${RC}
  --profile server|workstation   Override the configured profile
  --category <name>              Only checks in one category (e.g. SSH, Firewall)
  --domain <name>                Only one assessment domain: Server Hardening,
                                 OS Hardening, Network Security,
                                 Application Hardening, Database Hardening
  --level 1|2                    Only CIS Level ≤ N checks (2 includes 1)
  --framework cis                Only checks carrying a CIS Benchmark reference
  --check <ID>                   Only this check (repeatable)
  --format text|tsv|json|html|sarif|csv   Output format (audit/report; SARIF for code-scanning)
  --baseline <report.json>       audit: compare results against a saved report
  --dry-run                      harden: show every intended change, change nothing
  --yes, -y                      Assume "yes" to confirmations (automation)
  --quiet, -q                    Suppress progress output
  --debug                        Verbose diagnostics (timings, return codes)
  --tsv                          Shortcut for --format tsv

${BOLD}FLEET OPTIONS${RC} (auditxs fleet — read-only audit over SSH)
  --hosts a,b,c                  Hosts to audit (or list them as arguments)
  --inventory <file>             Read hosts from a file (one user@host per line)
  --user <name>                  Default SSH user for hosts without user@
  --key <file>                   SSH private key (key auth is preferred)
  --ask-pass                     Prompt once for an SSH login password (needs sshpass)
  --port <n>                     SSH port (default 22)
  --sudo                         Run the remote audit via passwordless sudo (sudo -n)
  --ask-sudo-pass                Prompt once for the remote sudo password (sudo -S)
  --timeout <sec>                Per-host timeout (default 120)
  --output <dir>                 Where to save per-host JSON reports
  --remote-report                Also leave a full HTML report on each host
  --strict-host-key              Require a pre-known host key (most strict)
  --insecure-host-key            Disable host-key checking (trusted networks only)

${BOLD}EXAMPLES${RC}
  sudo auditxs audit                        Full read-only audit + HTML/JSON report
  sudo auditxs harden --dry-run             Preview every change without applying
  sudo auditxs harden --category SSH        Harden SSH only, one fix at a time
  sudo auditxs rollback latest              Undo the most recent hardening run
  auditxs explain FW-002                    What it checks, changes, and how to revert
  sudo auditxs audit --baseline old.json    Show regressions/improvements vs. an old report
  auditxs fleet web01 db01 --user admin --key ~/.ssh/id_ed25519 --sudo
  auditxs errors AX6002                     Explain an error number

Supported: Debian, Ubuntu, Pop!_OS, Arch, Fedora, openSUSE (and derivatives).
Profiles:  server, workstation — chosen during installation (see /etc/auditxs/auditxs.conf).
EOF
}

resolve_profile() {
    if [ -n "${PROFILE_OVERRIDE:-}" ]; then
        PROFILE=$PROFILE_OVERRIDE
    elif [ -z "${PROFILE:-}" ]; then
        PROFILE=workstation
        warn "No profile configured (run the installer or pass --profile) — defaulting to 'workstation'."
    fi
    case $PROFILE in
        server|workstation) : ;;
        *) die "Invalid profile '$PROFILE' — must be 'server' or 'workstation'" ;;
    esac
}

# Graphical / web interfaces are disabled on the server profile: servers should
# expose only the CLI and the terminal (ncurses) UI — no web server or GUI
# running with root on a headless box. Override for a one-off with
# --profile workstation if you really are on a desktop.
require_workstation_interface() {
    if [ "$PROFILE" = server ]; then
        die "$1 is disabled on the 'server' profile.
On a server, use the terminal interface (works over SSH):  ${BOLD}sudo auditxs tui${RC}
or the CLI directly:  ${BOLD}sudo auditxs audit${RC} / ${BOLD}harden${RC}.
If this is actually a desktop, run with:  ${BOLD}--profile workstation${RC}"
    fi
}

# ------------------------------------------------------------ Qt runtime deps
# The Qt/QML desktop app needs PySide6 + the QtQuick QML modules it imports
# (Controls.Material, Layouts, Window). These are packaged separately from the
# core .deb (the optional 'auditxs-gui-qt' package), so a user who runs
# `auditxs qt` on a fresh install may not have them yet. Rather than fail with
# a raw ImportError, we detect the gap and offer to install the right packages
# for this distribution.

# _qt_packages — echo the distro-specific package list the Qt GUI needs.
_qt_packages() {
    case $DISTRO_FAMILY in
        debian) echo "python3-pyside6.qtquick qml6-module-qtquick-controls qml6-module-qtquick-layouts qml6-module-qtquick-window" ;;
        redhat) echo "python3-pyside6" ;;
        arch)   echo "pyside6" ;;
        suse)   echo "python3-pyside6" ;;
        *)      echo "" ;;
    esac
}

# _qt_install_hint "<pkgs>" — echo a copy-pasteable manual install command
# using the native package manager's real install syntax.
_qt_install_hint() {
    case $PKG in
        apt)    echo "sudo apt install $1" ;;
        pacman) echo "sudo pacman -S $1" ;;
        dnf)    echo "sudo dnf install $1" ;;
        zypper) echo "sudo zypper install $1" ;;
        *)      echo "install these packages: $1" ;;
    esac
}

# _qt_has_runtime — true when PySide6 and its QML view classes import.
_qt_has_runtime() {
    have python3 && python3 - <<'PY' >/dev/null 2>&1
import importlib
for m in ("PySide6.QtCore", "PySide6.QtGui", "PySide6.QtQml"):
    importlib.import_module(m)
PY
}

# _qt_desktop_session — true when we appear to be launched from a graphical
# session with no controlling terminal (e.g. a .desktop launcher). Used to
# decide between a terminal prompt and a graphical one.
_qt_desktop_session() {
    { [ -n "${DISPLAY:-}" ] || [ -n "${WAYLAND_DISPLAY:-}" ]; } && ! { [ -t 0 ] && [ -t 1 ]; }
}

# _qt_ask_install "<pkgs>" — ask the user whether to install the Qt packages.
# Returns 0 for yes. Uses a terminal prompt when attached to a tty, otherwise
# a zenity dialog when we have a display; if neither is possible, declines.
_qt_ask_install() {
    local pkgs=$1
    if [ -t 0 ] || [ -t 1 ]; then
        confirm "AuditXS Qt GUI needs additional packages:
  ${BOLD}${pkgs}${RC}
Install them now?"
        return $?
    fi
    if _qt_desktop_session && have zenity; then
        zenity --question --width=440 --title="AuditXS — install Qt support" \
            --text="The AuditXS desktop app needs additional Qt packages:\n\n<tt>${pkgs}</tt>\n\nInstall them now? (You may be asked for your password.)" \
            2>/dev/null
        return $?
    fi
    return 1
}

# _qt_install_packages "<pkgs>" — install the given packages with the native
# package manager, elevating privileges when we are not already root. Honours
# a graphical session by using pkexec so the password prompt is on-screen.
_qt_install_packages() {
    local pkgs=$1 cmd=""
    case $PKG in
        apt)    cmd="env DEBIAN_FRONTEND=noninteractive apt-get install -y -q $pkgs" ;;
        pacman) cmd="pacman -S --noconfirm --needed $pkgs" ;;
        dnf)    cmd="dnf install -y -q $pkgs" ;;
        zypper) cmd="zypper --non-interactive --quiet install $pkgs" ;;
        *)      ax_error AX5001 "no supported package manager for this distribution ($DISTRO_FAMILY)"; return 1 ;;
    esac

    say "Installing Qt support packages: ${BOLD}${pkgs}${RC}"
    if [ "$(id -u)" -eq 0 ]; then
        sh -c "$cmd"
    elif _qt_desktop_session && have pkexec; then
        pkexec sh -c "$cmd"
    elif have sudo; then
        sudo sh -c "$cmd"
    else
        ax_error AX5001 "cannot elevate to install packages (need root, pkexec or sudo)"
        return 1
    fi
}

# ensure_qt_runtime — make sure the Qt GUI can start; offer to install the
# missing packages when it cannot. Returns 0 when the runtime is ready, 1 when
# the user should fall back to another interface.
ensure_qt_runtime() {
    _qt_has_runtime && return 0

    local pkgs; pkgs=$(_qt_packages)
    warn "The AuditXS Qt GUI needs PySide6 and its QtQuick modules, which are not installed."

    if [ -z "$pkgs" ]; then
        ax_error AX5001 "no known Qt package set for this distribution ($DISTRO_FAMILY)"
        echo "Install PySide6 (with QtQuick Controls/Layouts) for python3, then re-run ${BOLD}auditxs qt${RC}, or use ${BOLD}sudo auditxs web${RC} instead." >&2
        return 1
    fi

    if _qt_ask_install "$pkgs"; then
        if _qt_install_packages "$pkgs" && _qt_has_runtime; then
            ok "Qt support installed — starting the AuditXS desktop app."
            return 0
        fi
        ax_error AX5001 "Qt support packages did not install cleanly"
    fi

    echo "The Qt GUI cannot start without those packages. You can:
  • install them manually:  ${BOLD}$(_qt_install_hint "$pkgs")${RC}
  • or use the web UI instead:  ${BOLD}sudo auditxs web${RC}
  • or the terminal UI:  ${BOLD}sudo auditxs tui${RC}" >&2
    return 1
}

# --------------------------------------------------------- Electron runtime
# The Electron desktop app (gui/electron) needs its Node dependency (Electron
# itself) fetched via npm on first use. ensure_electron_runtime detects that
# and offers to install it, mirroring the Qt preflight.
_gui_ask() {   # <title> <question> — yes/no via terminal or, headless, zenity
    local title=$1 q=$2
    if [ -t 0 ] || [ -t 1 ]; then
        confirm "$q"; return $?
    fi
    if _qt_desktop_session && have zenity; then
        zenity --question --width=460 --title="$title" --text="$q" 2>/dev/null; return $?
    fi
    return 1
}

ensure_electron_runtime() {   # <source app dir> — resolves ELECTRON_RUN_DIR
    local src=$1
    # The install dir (/opt/auditxs/…) is root-owned, so a normal user cannot
    # `npm install` there. When the source is not writable, run from a per-user
    # copy of the two tiny app files and install the dependency there instead.
    ELECTRON_RUN_DIR=$src
    if [ ! -w "$src" ]; then
        ELECTRON_RUN_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/auditxs/electron"
        mkdir -p "$ELECTRON_RUN_DIR" 2>/dev/null || { ax_error AX5001 "cannot create $ELECTRON_RUN_DIR"; return 1; }
        cp -f "$src/main.js" "$src/package.json" "$ELECTRON_RUN_DIR/" 2>/dev/null
    fi
    local eapp=$ELECTRON_RUN_DIR
    [ -x "$eapp/node_modules/.bin/electron" ] && return 0
    warn "The AuditXS Electron app needs its Node dependency (Electron), which is not installed yet."
    if have npm; then
        if _gui_ask "AuditXS — install Electron" \
               "The AuditXS desktop app needs to download Electron (~250 MB) with npm. Do this now?"; then
            say "Installing the Electron runtime (one time, into $eapp)…"
            if ( cd "$eapp" && npm install --no-audit --no-fund ) && [ -x "$eapp/node_modules/.bin/electron" ]; then
                ok "Electron installed — starting the AuditXS desktop app."
                return 0
            fi
            ax_error AX5001 "npm install failed in $eapp"
        fi
    else
        ax_error AX5001 "npm not found — install Node.js/npm to use the Electron app"
    fi
    echo "The Electron app cannot start yet. You can:
  • install its dependency:  ${BOLD}cd $eapp && npm install${RC}
  • or use the web UI instead:  ${BOLD}sudo auditxs web${RC}
  • or the Qt app:  ${BOLD}auditxs qt${RC}" >&2
    return 1
}

main() {
    local cmd=${1:-help}
    [ $# -gt 0 ] && shift

    FORMAT=text
    FILTER_CATEGORY=""
    FILTER_DOMAIN=""
    FILTER_LEVEL=""
    FILTER_FRAMEWORK=""
    FILTER_CHECKS=""
    PROFILE_OVERRIDE=""
    MARKDOWN=0
    BASELINE_FILE=""
    local -a ARGS=()

    while [ $# -gt 0 ]; do
        case $1 in
            --profile)   PROFILE_OVERRIDE=${2:?--profile needs a value}; shift ;;
            --category)  FILTER_CATEGORY=${2:?--category needs a value}; shift ;;
            --domain)    FILTER_DOMAIN=${2:?--domain needs a value}; shift ;;
            --level)     FILTER_LEVEL=${2:?--level needs a value}; shift ;;
            --framework) FILTER_FRAMEWORK=${2:?--framework needs a value}; shift ;;
            --check)     FILTER_CHECKS+=" ${2^^}"; shift ;;
            --format)    FORMAT=${2:?--format needs a value}; shift ;;
            --baseline)  BASELINE_FILE=${2:?--baseline needs a report file}; shift ;;
            --progress-file) AUDITXS_PROGRESS_FILE=${2:?--progress-file needs a path}; shift ;;
            --tsv)       FORMAT=tsv ;;
            --markdown)  MARKDOWN=1 ;;
            --dry-run)   DRYRUN=1 ;;
            --yes|-y)    ASSUME_YES=1 ;;
            --quiet|-q)  QUIET=1 ;;
            --debug)     DEBUG=1 ;;
            --help|-h)   usage; return 0 ;;
            --port)      ARGS+=("--port" "${2:?--port needs a value}"); shift ;;   # passthrough to web/tui/fleet
            --no-open)   ARGS+=("--no-open") ;;                                     # passthrough to web
            # fleet-mode options — passed through to 'auditxs fleet'
            --hosts|--inventory|--user|--key|--timeout|--output|--until)
                         ARGS+=("$1" "${2:?"$1 needs a value"}"); shift ;;
            --sudo|--ask-pass|--ask-sudo-pass|--sudo-pass|--strict-host-key|--insecure-host-key|--remote-report)
                         ARGS+=("$1") ;;
            -*)          die "Unknown option: $1 (see 'auditxs help')" ;;
            *)           ARGS+=("$1") ;;
        esac
        shift
    done

    init_logging
    detect_distro

    # shellcheck disable=SC1090
    [ -r "$AUDITXS_CONF" ] && . "$AUDITXS_CONF"

    case $cmd in
        version|--version|-V)
            echo "AuditXS v$AUDITXS_VERSION"
            return 0 ;;
        help|--help|-h)
            usage
            return 0 ;;
        list)
            resolve_profile
            if [ "$MARKDOWN" = 1 ]; then cmd_list --markdown; else cmd_list; fi
            return 0 ;;
        explain)
            resolve_profile
            cmd_explain "${ARGS[@]}"
            return 0 ;;
        audit)
            require_root audit
            resolve_profile
            log "audit started (profile=$PROFILE distro=$DISTRO_ID format=$FORMAT)"
            case $FORMAT in
                text)
                    print_audit_header
                    run_audit
                    print_summary
                    cve_scan; cve_banner
                    save_reports
                    [ -n "$BASELINE_FILE" ] && diff_current_against "$BASELINE_FILE" ;;
                tsv)   QUIET=1; run_audit; results_tsv ;;
                json)  QUIET=1; run_audit; results_json ;;
                html)  QUIET=1; run_audit; results_html ;;
                csv)   QUIET=1; run_audit; results_csv ;;
                sarif) QUIET=1; run_audit; results_sarif ;;
                *) ax_die AX7001 "format=$FORMAT" ;;
            esac
            return 0 ;;
        report)
            require_root report
            resolve_profile
            QUIET=1
            run_audit
            case $FORMAT in
                html|text) results_html ;;
                json)      results_json ;;
                tsv)       results_tsv ;;
                csv)       results_csv ;;
                sarif)     results_sarif ;;
                *) ax_die AX7001 "format=$FORMAT" ;;
            esac
            return 0 ;;
        harden)
            require_root harden
            resolve_profile
            log "harden started (profile=$PROFILE dry-run=$DRYRUN yes=$ASSUME_YES)"
            cmd_harden
            return 0 ;;
        snapshots)
            require_root snapshots
            if [ "$FORMAT" = tsv ]; then cmd_snapshots --tsv; else cmd_snapshots; fi
            return 0 ;;
        rollback)
            require_root rollback
            local id=${ARGS[0]:-}
            [ -n "$id" ] || die "Usage: sudo auditxs rollback <snapshot-id>|latest  (see 'sudo auditxs snapshots')"
            if [ "$id" = "latest" ]; then
                id=$(latest_snapshot) || true
                [ -n "$id" ] || die "No snapshot available to roll back."
                info "Latest snapshot: $id"
            fi
            rollback_snapshot "$id"
            return $? ;;
        diff)
            [ ${#ARGS[@]} -ge 1 ] || die "Usage: auditxs diff <baseline.json> [current.json]"
            cmd_diff "${ARGS[@]}"
            return $? ;;
        doctor)
            cmd_doctor
            return $? ;;
        cve)
            require_root cve
            cmd_cve
            return $? ;;
        tools)
            cmd_tools "${ARGS[@]}"
            return $? ;;
        tui)
            require_root tui
            resolve_profile
            [ -f "$AUDITXS_ROOT/gui/auditxs-tui.sh" ] || die "Terminal UI not found at $AUDITXS_ROOT/gui/auditxs-tui.sh"
            log "tui starting (profile=$PROFILE)"
            AUDITXS_BIN="$AUDITXS_SELF" AUDITXS_PROFILE="$PROFILE" \
                exec bash "$AUDITXS_ROOT/gui/auditxs-tui.sh" "${ARGS[@]}" ;;
        web)
            require_root web
            resolve_profile
            require_workstation_interface "the web UI"
            have python3 || die "The web UI requires python3 (standard library only). Install it, or use 'auditxs tui' / the CLI."
            [ -f "$AUDITXS_ROOT/gui/auditxs-web.py" ] || die "Web UI not found at $AUDITXS_ROOT/gui/auditxs-web.py"
            log "web UI starting (profile=$PROFILE)"
            AUDITXS_BIN="$AUDITXS_SELF" AUDITXS_PROFILE="$PROFILE" \
                exec python3 -u "$AUDITXS_ROOT/gui/auditxs-web.py" "${ARGS[@]}" ;;
        qt)
            # The Qt app runs UNPRIVILEGED and elevates each privileged action
            # itself (pkexec, like the zenity GUI), so the window displays
            # normally on both X11 and Wayland. No require_root here on purpose.
            resolve_profile
            require_workstation_interface "the Qt GUI"
            have python3 || die "The Qt GUI requires python3 + PySide6 (install the 'auditxs-gui-qt' package)."
            [ -f "$AUDITXS_ROOT/gui/auditxs-qt.py" ] || die "Qt GUI not found at $AUDITXS_ROOT/gui/auditxs-qt.py"
            ensure_qt_runtime || return 1
            log "qt GUI starting (profile=$PROFILE)"
            AUDITXS_BIN="$AUDITXS_SELF" AUDITXS_PROFILE="$PROFILE" \
                exec python3 "$AUDITXS_ROOT/gui/auditxs-qt.py" "${ARGS[@]}" ;;
        electron)
            # Electron desktop shell around the localhost web UI. Runs
            # UNPRIVILEGED; it elevates the (root) web server once with pkexec.
            resolve_profile
            require_workstation_interface "the Electron app"
            local eapp="$AUDITXS_ROOT/gui/electron"
            have node || die "The Electron app requires Node.js (node + npm). Install it, or use ${BOLD}auditxs web${RC} / ${BOLD}auditxs qt${RC}."
            [ -f "$eapp/main.js" ] || die "Electron app not found at $eapp"
            ensure_electron_runtime "$eapp" || return 1
            log "electron app starting (profile=$PROFILE, dir=$ELECTRON_RUN_DIR)"
            AUDITXS_BIN="$AUDITXS_SELF" AUDITXS_PROFILE="$PROFILE" \
                exec "$ELECTRON_RUN_DIR/node_modules/.bin/electron" "$ELECTRON_RUN_DIR" "${ARGS[@]}" ;;
        profile)
            resolve_profile
            echo "$PROFILE"
            return 0 ;;
        errors|error)
            if [ "$MARKDOWN" = 1 ]; then cmd_errors --markdown; else cmd_errors "${ARGS[@]}"; fi
            return $? ;;
        waive)
            resolve_profile; cmd_waive "${ARGS[@]}"; return $? ;;
        unwaive)
            resolve_profile; cmd_unwaive "${ARGS[@]}"; return $? ;;
        waivers)
            resolve_profile; cmd_waivers; return $? ;;
        alert|alerts)
            cmd_alert "${ARGS[@]}"; return $? ;;
        fleet)
            resolve_profile
            cmd_fleet "${ARGS[@]}"
            return $? ;;
        baseline)
            cmd_baseline "${ARGS[@]}"
            return $? ;;
        schedule)
            resolve_profile
            cmd_schedule "${ARGS[@]}"
            return $? ;;
        *)
            die "Unknown command: $cmd (see 'auditxs help')" ;;
    esac
}

main "$@"
