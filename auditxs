#!/usr/bin/env bash
#
# AuditXS — transparent, reversible Linux security auditing & hardening.
# https://github.com/digitalxs/AuditXS
#
# Design principles:
#   1. TRANSPARENT — every check explains what it inspects, why it matters,
#      exactly what its fix changes, and how that change is reverted.
#      'auditxs audit' is strictly read-only.
#   2. REVERSIBLE — before anything is modified it is recorded in a snapshot
#      (file copies + action manifest). 'auditxs rollback' restores it.
#   3. CONSENTED — fixes are applied one by one, each after an explicit
#      confirmation (or --yes for automation), with --dry-run to preview.
#
# Copyright (c) 2026 DigitalXS <luis@digitalxs.ca>
#

AUDITXS_SELF=$(readlink -f "${BASH_SOURCE[0]}")
AUDITXS_ROOT=$(dirname "$AUDITXS_SELF")

for _lib in core distro backup registry report fixlib maintenance cve tools; do
    # shellcheck disable=SC1090
    . "$AUDITXS_ROOT/lib/$_lib.sh" || { echo "auditxs: missing library lib/$_lib.sh" >&2; exit 1; }
done
for _chk in "$AUDITXS_ROOT"/checks/*.sh; do
    # shellcheck disable=SC1090
    . "$_chk" || { echo "auditxs: failed to load $_chk" >&2; exit 1; }
done

AUDITXS_CONF=/etc/auditxs/auditxs.conf

usage() {
    cat <<EOF
${BOLD}AuditXS v$AUDITXS_VERSION${RC} — transparent, reversible Linux security auditing

${BOLD}USAGE${RC}
  auditxs <command> [options]

${BOLD}COMMANDS${RC}
  audit       Run all applicable checks (read-only — never changes anything)
  harden      Review failed checks and apply fixes one by one, with consent
  rollback    Revert a hardening snapshot:  auditxs rollback <id> | latest
  snapshots   List change snapshots
  list        Show the check catalogue (add --markdown for full docs)
  explain     Show full documentation for checks:  auditxs explain SSH-001 ...
  report      Print a report of a fresh audit to stdout (--format html|json|tsv)
  diff        Compare two saved JSON reports:  auditxs diff <baseline.json> [current.json]
              (current defaults to the latest saved report; exits 1 on regressions)
  baseline    Manage the approved baseline:  auditxs baseline set [report] | show | clear
  schedule    Daily audit + drift alert:  auditxs schedule enable | disable | status | run
  doctor      Diagnose the AuditXS installation, tooling and snapshot integrity
  cve         Warn about installed packages with a known vulnerability / CVE
  tools       Security tooling:  auditxs tools status | install <name> | scan | vpn
  tui         Launch the terminal (ncurses) interface — works over SSH; server-friendly
  web         Launch the local web UI (Material Design 3) — workstation profile only
  qt          Launch the native Qt/QML desktop app — workstation profile only
  profile     Print the resolved profile (server|workstation)
  version     Show version
  help        Show this help

${BOLD}INTERFACES BY PROFILE${RC}
  server        CLI + terminal UI (tui) only — no web/graphical server on this box
  workstation   all of the above plus web UI, Qt app and the zenity GUI

${BOLD}OPTIONS${RC}
  --profile server|workstation   Override the configured profile
  --category <name>              Only checks in one category (e.g. SSH, Firewall)
  --domain <name>                Only one assessment domain: Server Hardening,
                                 OS Hardening, Network Security,
                                 Application Hardening, Database Hardening
  --level 1|2                    Only CIS Level ≤ N checks (2 includes 1)
  --framework cis                Only checks carrying a CIS Benchmark reference
  --check <ID>                   Only this check (repeatable)
  --format text|tsv|json|html    Output format (audit/report)
  --baseline <report.json>       audit: compare results against a saved report
  --dry-run                      harden: show every intended change, change nothing
  --yes, -y                      Assume "yes" to confirmations (automation)
  --quiet, -q                    Suppress progress output
  --debug                        Verbose diagnostics (timings, return codes)
  --tsv                          Shortcut for --format tsv

${BOLD}EXAMPLES${RC}
  sudo auditxs audit                        Full read-only audit + HTML/JSON report
  sudo auditxs harden --dry-run             Preview every change without applying
  sudo auditxs harden --category SSH        Harden SSH only, one fix at a time
  sudo auditxs rollback latest              Undo the most recent hardening run
  auditxs explain FW-002                    What it checks, changes, and how to revert
  sudo auditxs audit --baseline old.json    Show regressions/improvements vs. an old report

Supported: Debian, Ubuntu, Pop!_OS, Arch, Fedora, openSUSE (and derivatives).
Profiles:  server, workstation — chosen during installation (see /etc/auditxs/auditxs.conf).
EOF
}

resolve_profile() {
    if [ -n "${PROFILE_OVERRIDE:-}" ]; then
        PROFILE=$PROFILE_OVERRIDE
    elif [ -z "${PROFILE:-}" ]; then
        PROFILE=workstation
        warn "No profile configured (run the installer or pass --profile) — defaulting to 'workstation'."
    fi
    case $PROFILE in
        server|workstation) : ;;
        *) die "Invalid profile '$PROFILE' — must be 'server' or 'workstation'" ;;
    esac
}

# Graphical / web interfaces are disabled on the server profile: servers should
# expose only the CLI and the terminal (ncurses) UI — no web server or GUI
# running with root on a headless box. Override for a one-off with
# --profile workstation if you really are on a desktop.
require_workstation_interface() {
    if [ "$PROFILE" = server ]; then
        die "$1 is disabled on the 'server' profile.
On a server, use the terminal interface (works over SSH):  ${BOLD}sudo auditxs tui${RC}
or the CLI directly:  ${BOLD}sudo auditxs audit${RC} / ${BOLD}harden${RC}.
If this is actually a desktop, run with:  ${BOLD}--profile workstation${RC}"
    fi
}

main() {
    local cmd=${1:-help}
    [ $# -gt 0 ] && shift

    FORMAT=text
    FILTER_CATEGORY=""
    FILTER_DOMAIN=""
    FILTER_LEVEL=""
    FILTER_FRAMEWORK=""
    FILTER_CHECKS=""
    PROFILE_OVERRIDE=""
    MARKDOWN=0
    BASELINE_FILE=""
    local -a ARGS=()

    while [ $# -gt 0 ]; do
        case $1 in
            --profile)   PROFILE_OVERRIDE=${2:?--profile needs a value}; shift ;;
            --category)  FILTER_CATEGORY=${2:?--category needs a value}; shift ;;
            --domain)    FILTER_DOMAIN=${2:?--domain needs a value}; shift ;;
            --level)     FILTER_LEVEL=${2:?--level needs a value}; shift ;;
            --framework) FILTER_FRAMEWORK=${2:?--framework needs a value}; shift ;;
            --check)     FILTER_CHECKS+=" ${2^^}"; shift ;;
            --format)    FORMAT=${2:?--format needs a value}; shift ;;
            --baseline)  BASELINE_FILE=${2:?--baseline needs a report file}; shift ;;
            --tsv)       FORMAT=tsv ;;
            --markdown)  MARKDOWN=1 ;;
            --dry-run)   DRYRUN=1 ;;
            --yes|-y)    ASSUME_YES=1 ;;
            --quiet|-q)  QUIET=1 ;;
            --debug)     DEBUG=1 ;;
            --help|-h)   usage; return 0 ;;
            --port)      ARGS+=("--port" "${2:?--port needs a value}"); shift ;;   # passthrough to web/tui
            --no-open)   ARGS+=("--no-open") ;;                                     # passthrough to web
            -*)          die "Unknown option: $1 (see 'auditxs help')" ;;
            *)           ARGS+=("$1") ;;
        esac
        shift
    done

    init_logging
    detect_distro

    # shellcheck disable=SC1090
    [ -r "$AUDITXS_CONF" ] && . "$AUDITXS_CONF"

    case $cmd in
        version|--version|-V)
            echo "AuditXS v$AUDITXS_VERSION"
            return 0 ;;
        help|--help|-h)
            usage
            return 0 ;;
        list)
            resolve_profile
            if [ "$MARKDOWN" = 1 ]; then cmd_list --markdown; else cmd_list; fi
            return 0 ;;
        explain)
            resolve_profile
            cmd_explain "${ARGS[@]}"
            return 0 ;;
        audit)
            require_root audit
            resolve_profile
            log "audit started (profile=$PROFILE distro=$DISTRO_ID format=$FORMAT)"
            case $FORMAT in
                text)
                    print_audit_header
                    run_audit
                    print_summary
                    cve_scan; cve_banner
                    save_reports
                    [ -n "$BASELINE_FILE" ] && diff_current_against "$BASELINE_FILE" ;;
                tsv)  QUIET=1; run_audit; results_tsv ;;
                json) QUIET=1; run_audit; results_json ;;
                html) QUIET=1; run_audit; results_html ;;
                *) die "Unknown format: $FORMAT" ;;
            esac
            return 0 ;;
        report)
            require_root report
            resolve_profile
            QUIET=1
            run_audit
            case $FORMAT in
                html|text) results_html ;;
                json)      results_json ;;
                tsv)       results_tsv ;;
                *) die "Unknown format: $FORMAT" ;;
            esac
            return 0 ;;
        harden)
            require_root harden
            resolve_profile
            log "harden started (profile=$PROFILE dry-run=$DRYRUN yes=$ASSUME_YES)"
            cmd_harden
            return 0 ;;
        snapshots)
            require_root snapshots
            if [ "$FORMAT" = tsv ]; then cmd_snapshots --tsv; else cmd_snapshots; fi
            return 0 ;;
        rollback)
            require_root rollback
            local id=${ARGS[0]:-}
            [ -n "$id" ] || die "Usage: sudo auditxs rollback <snapshot-id>|latest  (see 'sudo auditxs snapshots')"
            if [ "$id" = "latest" ]; then
                id=$(latest_snapshot) || true
                [ -n "$id" ] || die "No snapshot available to roll back."
                info "Latest snapshot: $id"
            fi
            rollback_snapshot "$id"
            return $? ;;
        diff)
            [ ${#ARGS[@]} -ge 1 ] || die "Usage: auditxs diff <baseline.json> [current.json]"
            cmd_diff "${ARGS[@]}"
            return $? ;;
        doctor)
            cmd_doctor
            return $? ;;
        cve)
            require_root cve
            cmd_cve
            return $? ;;
        tools)
            cmd_tools "${ARGS[@]}"
            return $? ;;
        tui)
            require_root tui
            resolve_profile
            [ -f "$AUDITXS_ROOT/gui/auditxs-tui.sh" ] || die "Terminal UI not found at $AUDITXS_ROOT/gui/auditxs-tui.sh"
            log "tui starting (profile=$PROFILE)"
            AUDITXS_BIN="$AUDITXS_SELF" AUDITXS_PROFILE="$PROFILE" \
                exec bash "$AUDITXS_ROOT/gui/auditxs-tui.sh" "${ARGS[@]}" ;;
        web)
            require_root web
            resolve_profile
            require_workstation_interface "the web UI"
            have python3 || die "The web UI requires python3 (standard library only). Install it, or use 'auditxs tui' / the CLI."
            [ -f "$AUDITXS_ROOT/gui/auditxs-web.py" ] || die "Web UI not found at $AUDITXS_ROOT/gui/auditxs-web.py"
            log "web UI starting (profile=$PROFILE)"
            AUDITXS_BIN="$AUDITXS_SELF" AUDITXS_PROFILE="$PROFILE" \
                exec python3 -u "$AUDITXS_ROOT/gui/auditxs-web.py" "${ARGS[@]}" ;;
        qt)
            # The Qt app runs UNPRIVILEGED and elevates each privileged action
            # itself (pkexec, like the zenity GUI), so the window displays
            # normally on both X11 and Wayland. No require_root here on purpose.
            resolve_profile
            require_workstation_interface "the Qt GUI"
            have python3 || die "The Qt GUI requires python3 + PySide6 (install the 'auditxs-gui-qt' package)."
            [ -f "$AUDITXS_ROOT/gui/auditxs-qt.py" ] || die "Qt GUI not found at $AUDITXS_ROOT/gui/auditxs-qt.py"
            log "qt GUI starting (profile=$PROFILE)"
            AUDITXS_BIN="$AUDITXS_SELF" AUDITXS_PROFILE="$PROFILE" \
                exec python3 "$AUDITXS_ROOT/gui/auditxs-qt.py" "${ARGS[@]}" ;;
        profile)
            resolve_profile
            echo "$PROFILE"
            return 0 ;;
        baseline)
            cmd_baseline "${ARGS[@]}"
            return $? ;;
        schedule)
            resolve_profile
            cmd_schedule "${ARGS[@]}"
            return $? ;;
        *)
            die "Unknown command: $cmd (see 'auditxs help')" ;;
    esac
}

main "$@"
