#!/usr/bin/env bash
#
# AuditXS — transparent, reversible Linux security auditing & hardening.
# https://github.com/digitalxs/AuditXS
#
# Design principles:
#   1. TRANSPARENT — every check explains what it inspects, why it matters,
#      exactly what its fix changes, and how that change is reverted.
#      'auditxs audit' is strictly read-only.
#   2. REVERSIBLE — before anything is modified it is recorded in a snapshot
#      (file copies + action manifest). 'auditxs rollback' restores it.
#   3. CONSENTED — fixes are applied one by one, each after an explicit
#      confirmation (or --yes for automation), with --dry-run to preview.
#
# Copyright (c) 2026 DigitalXS <luis@digitalxs.ca>
#

AUDITXS_SELF=$(readlink -f "${BASH_SOURCE[0]}")
AUDITXS_ROOT=$(dirname "$AUDITXS_SELF")

for _lib in core errors distro backup registry waivers report fixlib maintenance cve tools lynis update fleet alerts webservice terminal; do
    # shellcheck disable=SC1090
    . "$AUDITXS_ROOT/lib/$_lib.sh" || { echo "auditxs: missing library lib/$_lib.sh" >&2; exit 1; }
done
for _chk in "$AUDITXS_ROOT"/checks/*.sh; do
    # shellcheck disable=SC1090
    . "$_chk" || { echo "auditxs: failed to load $_chk" >&2; exit 1; }
done

AUDITXS_CONF=/etc/auditxs/auditxs.conf

usage() {
    cat <<EOF
${BOLD}AuditXS v$AUDITXS_VERSION${RC} — transparent, reversible Linux security auditing

${BOLD}USAGE${RC}
  auditxs <command> [options]

${BOLD}COMMANDS${RC}
  start       Guided run for newcomers: audit, then fix issues one at a time
  audit       Run all applicable checks (read-only — never changes anything)
  harden      Review failed checks and apply fixes one by one, with consent
  rollback    Revert a hardening snapshot:  auditxs rollback <id> | latest
  snapshots   List change snapshots
  list        Show the check catalogue (add --markdown for full docs)
  explain     Show full documentation for checks:  auditxs explain SSH-001 ...
  report      Print a report of a fresh audit to stdout (--format html|json|tsv)
  diff        Compare two saved JSON reports:  auditxs diff <baseline.json> [current.json]
              (current defaults to the latest saved report; exits 1 on regressions)
  baseline    Manage the approved baseline:  auditxs baseline set [report] | show | clear
  schedule    Daily audit + drift alert:  auditxs schedule enable | disable | status | run
  doctor      Diagnose the AuditXS installation, tooling and snapshot integrity
  cve         Warn about installed packages with a known vulnerability / CVE
  update      Apply pending package updates (security by default; --all, --dry-run)
  tools       Security tooling:  status | list | install/uninstall/repair <name> | scan | vpn
  lynis       Run Lynis (independent host audit) and fold its findings in (--report to reuse the last run)
  fleet       Audit many hosts over SSH (read-only):  auditxs fleet <host...> [options]
  waive       Accept a finding as a documented risk:  auditxs waive <ID> "reason" [--until DATE]
  waivers     List accepted-risk waivers   ·   unwaive <ID> removes one
  alert       Configure/test drift & CVE alert sinks:  auditxs alert status | test
  errors      Browse the error-code catalogue:  auditxs errors [CODE|term|log]
  terminal    Open a real, fully-interactive terminal (a shell) — prefers Konsole
  tui         Launch the terminal (ncurses) interface — works over SSH; server-friendly
  web         Launch the web UI (Material Design 3); localhost by default, --remote for the network
  webservice  Turn the web UI on/off as a service:  status | enable [--remote] | disable | token
  qt          Launch the native Qt/QML desktop app — workstation profile only
  electron    Launch the Electron desktop app (web UI in a window) — workstation only
  profile     Print the resolved profile (server|workstation)
